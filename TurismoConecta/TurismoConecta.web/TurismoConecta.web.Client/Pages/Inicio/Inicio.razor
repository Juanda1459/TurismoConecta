@page "/"

@using System.Linq
@using Microsoft.AspNetCore.Components.Web
@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.JSInterop
@using TurismoConecta.web.Client.Services

@layout EmptyLayout
@rendermode @(new InteractiveWebAssemblyRenderMode(prerender: false))
@inject SitioTuristicoApiService SitioService
@inject MunicipioApiService ApiService
@inject EtiquetaApiService EtiquetaService
@inject NavigationManager Nav
@inject IJSRuntime JS
@inject AuthenticationStateProvider AuthStateProvider

<PageTitle>Turismo Conecta | Descubre Colombia</PageTitle>

<HeadContent>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet" href="Pages/inicio.razor.css" />
    <link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,500;0,600;0,700;1,500&family=Montserrat:wght@400;500;600;700;800&display=swap" rel="stylesheet" />
  </HeadContent>
    

<div class="inicio-page">

    <header class="inicio-navbar">
        <a href="/" class="inicio-logo">
            <img src="images/turismo-conecta-logo.png"
                 alt="Turismo Conecta" />
        </a>

        <nav class="inicio-navigation" aria-label="Navegación principal">
            <a href="#quienes-somos">Quiénes somos</a>
            <a href="#donde-ir">Dónde ir</a>
            <a href="#gustos">Gustos y preferencias</a>
            <a href="#recomendaciones">Recomendaciones</a>
        </nav>

        <div class="inicio-actions">
            <button type="button"
                    class="nav-button"
                    aria-label="Buscar"
                    @onclick="MostrarBuscador">
                <span>🔎</span>
            </button>

            <AuthorizeView>
                <Authorized>
                    <button type="button"
                            class="nav-button nav-power"
                            aria-label="Mi Panel"
                            @onclick="IrAlDashboard"
                            title="Ir a mi panel">
                        <span>▦</span>
                    </button>
                    <a href="/perfil"
                       class="nav-button"
                       aria-label="Mi cuenta"
                       title="Mi cuenta">
                        <span>●</span>
                    </a>
                    <button type="button"
                            class="nav-button"
                            style="color: #ff9b9b; border-color: rgba(220, 53, 69, 0.4);"
                            aria-label="Cerrar sesión"
                            @onclick="CerrarSesion"
                            title="Cerrar sesión">
                        <span style="font-size: 0.8rem;">✕</span>
                    </button>
                </Authorized>
                <NotAuthorized>
                    <a href="/login"
                       class="nav-button"
                       aria-label="Iniciar sesión">
                        <span>●</span>
                    </a>
                    <a href="/register"
                       class="nav-button nav-power"
                       aria-label="Registrarse">
                        <span>↗</span>
                    </a>
                </NotAuthorized>
            </AuthorizeView>
        </div>
    </header>

    @if (mostrarBuscador)
    {
        <div class="buscador-navegacion">
            <input @bind="textoBusqueda"
                   @bind:event="oninput"
                   @onkeyup="DetectarEnterBusqueda"
                   placeholder="Busca un municipio, destino o experiencia..."
                   autofocus />

            <button type="button" @onclick="Buscar">
                Explorar
            </button>
        </div>
    }

    <main>

        <section class="hero-inicio">
            <div class="hero-overlay"></div>
            <div class="hero-decoracion hero-decoracion-superior"></div>
            <div class="hero-decoracion hero-decoracion-inferior"></div>

            <div class="hero-contenido">
                <span class="hero-etiqueta">
                    Turismo Conecta · Colombia
                </span>

                <h1>
                    Donde cada camino
                    <em>cuenta una historia.</em>
                </h1>

                <p>
                    Conecta con pueblos llenos de color, páramos que respiran,
                    sabores tradicionales y experiencias auténticas.
                </p>

                <form class="hero-buscador"
                      @onsubmit="Buscar"
                      @onsubmit:preventDefault>

                    <span class="hero-buscador-icono">⌕</span>

                    <input @bind="textoBusqueda"
                           @bind:event="oninput"
                           placeholder="¿Qué pueblo quieres conocer?" />

                    <button type="submit">
                        Buscar
                    </button>
                </form>

                <div class="hero-enlaces">
                    <a href="#donde-ir">Explorar destinos</a>
                    <a href="#gustos">Ver experiencias</a>
                </div>
            </div>

            <div class="hero-mapa-resumen">
                <div class="hero-mapa-titulo">
                    <span>Comenzamos en</span>
                    <strong>@zonaMapa</strong>
                </div>

                <div class="hero-mapa-contenedor">
                    <div id="mapa-colombia"
                         class="mapa-colombia">
                    </div>

                    <div class="hero-mapa-indicador">
                        <span></span>
                        Desliza para acercarte a Boyacá
                    </div>
                </div>
            </div>
        </section>

        <section class="historia-section" id="quienes-somos">
            <div class="historia-grid">
                <div>
                    <span class="section-eyebrow">
                        Nuestra esencia
                    </span>

                    <h2>
                        Colombia se descubre
                        <em>pueblo a pueblo.</em>
                    </h2>
                </div>

                <div class="historia-texto">
                    <p>
                        Turismo Conecta es un espacio para encontrar municipios,
                        paisajes, tradiciones, negocios y experiencias locales.
                    </p>

                    <p>
                        Nuestro recorrido comienza en Boyacá, una región de
                        páramos, arquitectura colonial, gastronomía y cultura.
                    </p>

                    <a href="/quienes-somos" class="enlace-destacado">
                        Conoce nuestra historia →
                    </a>
                </div>
            </div>
        </section>

        <section class="estadisticas-section">
            <article>
                <strong>@(totalMunicipios?.ToString() ?? "0")</strong>
                <span>Municipios registrados</span>
            </article>

            <article>
                <strong>@etiquetas.Count</strong>
                <span>Formas de viajar</span>
            </article>

            <article>
                <strong>Boyacá</strong>
                <span>Primer territorio conectado</span>
            </article>
        </section>

        
            
               <section class="destinos-page" id="donde-ir">

    <div class="destinos-heading">
        <span class="eyebrow">DESCUBRE BOYACÁ</span>
        <h1>¿Dónde quieres ir?</h1>
        <p>Explora los municipios registrados y encuentra el destino ideal para tu próxima aventura.</p>
    </div>

    <div class="destinos-marquee" aria-label="Sitios turísticos mejor reseñados">
    <div class="destinos-track @(carruselPausado ? "pausado" : "")"
     @onmouseenter="() => carruselPausado = true"
     @onmouseleave="() => carruselPausado = false"
     @onclick="() => carruselPausado = !carruselPausado">
    @for (int i = 0; i < sitiosParaMarquee.Count; i++)
    {        
        var sitio = sitiosParaMarquee[i];
        <article class="destino-frame">
            <a href="@($"/municipios/{sitio.IdMunicipio}")" class="destino-link" aria-label="Ver @sitio.Nombre">
                <div class="destino-image-wrap">
                    <img src="@sitio.ImagenUrl" alt="@sitio.Nombre" class="destino-image" />
                    <span class="destino-number">@(((i % sitiosTuristicos.Count) + 1).ToString("00"))</span>
                </div>
                <div class="destino-content">
                    <div class="destino-topline">
                        <h2>@sitio.Nombre</h2>
                        <span class="destino-rating">@(sitio.Calificacion.HasValue ? $"★ {sitio.Calificacion:0.0}" : "Nuevo")</span>
                    </div>
                    <span class="destino-category">@sitio.NombreMunicipio</span>
                    <span class="destino-cta">Ver municipio <span aria-hidden="true">→</span></span>
                </div>
            </a>
        </article>
    }
    
</div>
    </div>

    <div class="destinos-footer">
        <span></span>
        <p>Los destinos favoritos de nuestros viajeros</p>
        <span></span>
    </div>
</section>

                <div class="centrar-boton">
                    <a href="/municipios"
                       class="boton-principal">
                        Ver todos los municipios
                    </a>
                </div>
            }
        

        <section class="gustos-section" id="gustos">
            <div class="section-heading gustos-heading">
                <div>
                    <span class="section-eyebrow">
                        Personaliza tu recorrido
                    </span>

                    <h2>
                        ¿Qué te gusta?
                    </h2>
                </div>

                <p>
                    Elige una categoría y descubre municipios relacionados
                    con tus intereses.
                </p>
            </div>

            @if (cargandoEtiquetas)
            {
                <div class="gustos-grid">
                    @for (var i = 0; i < 6; i++)
                    {
                        <div class="gusto-skeleton"></div>
                    }
                </div>
            }
            else if (etiquetas.Count == 0)
            {
                <p class="estado-vacio-oscuro">
                    No hay categorías disponibles.
                </p>
            }
            else
            {
                <div class="gustos-grid">
                    @foreach (var etiqueta in etiquetas)
                    {
                        <button type="button"
                                class="gusto-card"
                                @onclick="() => FiltrarPorEtiqueta(etiqueta.IdEtiqueta)">

                            <span class="gusto-icono">
                                @(string.IsNullOrWhiteSpace(etiqueta.Icono)
                                    ? "✦"
                                    : etiqueta.Icono)
                            </span>

                            <strong>@etiqueta.Nombre</strong>

                            <span class="gusto-flecha">↗</span>
                        </button>
                    }
                </div>
            }
        </section>

        <section class="recomendaciones-section"
                 id="recomendaciones">

            <div class="recomendaciones-intro">
                <span class="section-eyebrow">
                    Antes de viajar
                </span>

                <h2>
                    Recomendaciones
                    <em>de viaje.</em>
                </h2>

                <p>
                    Prepárate para disfrutar cada destino con respeto,
                    curiosidad y tranquilidad.
                </p>
            </div>

            <div class="recomendaciones-grid">
                <article>
                    <span>01</span>
                    <h3>Lleva tu ruana</h3>
                    <p>
                        El clima de montaña puede cambiar rápidamente.
                        Lleva prendas cómodas y abrigadas.
                    </p>
                </article>

                <article>
                    <span>02</span>
                    <h3>Prueba lo local</h3>
                    <p>
                        Apoya la gastronomía, los artesanos y los negocios
                        de cada municipio.
                    </p>
                </article>

                <article>
                    <span>03</span>
                    <h3>Cuida el territorio</h3>
                    <p>
                        Respeta los páramos, los senderos, las comunidades
                        y el patrimonio.
                    </p>
                </article>

                <article>
                    <span>04</span>
                    <h3>Planea tu recorrido</h3>
                    <p>
                        Consulta las rutas, los horarios y las condiciones
                        antes de viajar.
                    </p>
                </article>
            </div>
        </section>

        <section class="itinerario-section">
            <div>
                <span class="section-eyebrow">
                    Planea tu aventura
                </span>

                <h2>
                    Arma tu itinerario
                    <em>por Colombia.</em>
                </h2>

                <p>
                    Guarda municipios, organiza tus paradas y construye
                    un recorrido pensado para ti.
                </p>
            </div>

            <button type="button"
                    class="boton-oscuro"
                    @onclick='() => Nav.NavigateTo("/itinerarios/crear")'>
                Crear itinerario
            </button>
        </section>
    </main>

<section class="valores-section">
    <div class="valores-grid">
        <div class="valor-card">
            <span class="valor-icono">🗺️</span>
            <h3>Catálogo completo</h3>
            <p>Información verificada de los municipios: historia, clima, fechas y actividades.</p>
        </div>
        <div class="valor-card">
            <span class="valor-icono">🧭</span>
            <h3>Itinerarios a tu medida</h3>
            <p>Arma tu recorrido entre varios pueblos y compártelo con quien quieras viajar contigo.</p>
        </div>
        <div class="valor-card">
            <span class="valor-icono">🏨</span>
            <h3>Negocios verificados</h3>
            <p>Hoteles, restaurantes y artesanos aprobados por la administración de cada municipio.</p>
        </div>
        <div class="valor-card">
            <span class="valor-icono">⭐</span>
            <h3>Reseñas reales</h3>
            <p>Opiniones de otros viajeros para que decidas con información de primera mano.</p>
        </div>
    </div>
</section>

<section class="cta-final">
    <h2>Tu próximo viaje por Boyacá empieza aquí</h2>
    <p>Crea tu cuenta gratis y guarda tus municipios y negocios favoritos.</p>
    <a href="/usuarios/register" class="boton-principal">Crear cuenta gratis</a>
</section>
    <footer class="inicio-footer">
        <div>
            <img src="images/turismo-conecta-logo.png"
                 alt="Turismo Conecta" />

            <p>
                Descubre Colombia, municipio a municipio.
            </p>
        </div>

        <div class="footer-links">
            <a href="#quienes-somos">Quiénes somos</a>
            <a href="#donde-ir">Dónde ir</a>
            <a href="#gustos">Preferencias</a>
            <a href="/itinerarios">Itinerarios</a>
        </div>
    </footer>

    <CondorChat />
</div>
@code {
    private string textoBusqueda = "";
    private string zonaMapa = "Colombia";
    private bool carruselPausado = false;
    private bool mostrarBuscador;
    private bool cargandoMunicipios = true;
    private bool cargandoEtiquetas = true;
    private bool mapaInicializado;

    private int? totalMunicipios;

    private List<MunicipioListadoDto> todosMunicipios = new();
    private List<MunicipioListadoDto> municipiosMostrados = new();
    private List<EtiquetaDto> etiquetas = new();
    private List<SitioTuristicoDto> sitiosTuristicos = new();
    private List<SitioTuristicoDto> sitiosParaMarquee => sitiosTuristicos.Concat(sitiosTuristicos).ToList();
    private string? mensajeBusqueda;

    // Redirige al dashboard según el rol del usuario autenticado
    private async Task IrAlDashboard()
    {
        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        var user = authState.User;

        if (!user.Identity?.IsAuthenticated ?? true)
        {
            Nav.NavigateTo("/login");
            return;
        }

        var rol = user.FindFirst(System.Security.Claims.ClaimTypes.Role)?.Value
               ?? user.FindFirst("role")?.Value;

        var destino = rol switch
        {
            "AdminGeneral"   => "/admin/dashboard",
            "AdminMunicipio" => "/municipio/dashboard",
            "AdminComercio"  => "/comercio/dashboard",
            _                => "/perfil"
        };

        Nav.NavigateTo(destino);
    }

    protected override async Task OnInitializedAsync()
    {
        await CargarMunicipios();
        await CargarEtiquetas();
        await CargarSitiosTuristicos();
    }

    private async Task CargarMunicipios()
    {
        cargandoMunicipios = true;
        try
        {
            var resultado = await ApiService.ListarAsync(1, 200);
            todosMunicipios = resultado?.Items?.ToList() ?? new List<MunicipioListadoDto>();
            municipiosMostrados = todosMunicipios;
            totalMunicipios = resultado?.Total;
        }
        catch
        {
            todosMunicipios = new List<MunicipioListadoDto>();
            municipiosMostrados = new List<MunicipioListadoDto>();
            totalMunicipios = 0;
        }
        finally
        {
            cargandoMunicipios = false;
        }
    }

    private async Task CargarEtiquetas()
    {
        cargandoEtiquetas = true;
        try
        {
            var resultado = await EtiquetaService.ListarAsync();
            etiquetas = resultado?.ToList() ?? new List<EtiquetaDto>();
        }
        catch
        {
            etiquetas = new List<EtiquetaDto>();
        }
        finally
        {
            cargandoEtiquetas = false;
        }
    }

    private async Task CargarSitiosTuristicos()
    {
        try { sitiosTuristicos = await SitioService.ListarAsync(); }
        catch { sitiosTuristicos = new(); }
    }

    private List<string> ObtenerAtractivosPorDefecto(string nombre)
    {
        if (nombre.Contains("Gámeza", StringComparison.OrdinalIgnoreCase))
            return new List<string> { "Cañón de Gámeza", "Laguna Negra", "Piedra Pintada Muisca", "Parque Minero Tradicional" };
        if (nombre.Contains("Ráquira", StringComparison.OrdinalIgnoreCase))
            return new List<string> { "Plaza de Cerámica", "Monasterio La Candelaria", "Talleres de Alfarería Tradicional" };
        return new List<string> { "Plaza Principal", "Templo Colonial", "Senderos Ecoturísticos", "Mirador del Valle" };
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender || mapaInicializado || cargandoMunicipios) return;

        var municipiosParaMapa = todosMunicipios
            .Where(m => m.Latitud.HasValue && m.Longitud.HasValue)
            .Select(m => new { id = m.IdMunicipio, nombre = m.Nombre, latitud = m.Latitud!.Value, longitud = m.Longitud!.Value })
            .ToList();

        try
        {
            await JS.InvokeVoidAsync("TurismoConectaMapa.inicializar", municipiosParaMapa, DotNetObjectReference.Create(this));
            await JS.InvokeVoidAsync("TurismoConectaMapa.activarScroll");
            mapaInicializado = true;
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error al inicializar mapa: {ex.Message}");
        }
    }

    private void MostrarBuscador() => mostrarBuscador = !mostrarBuscador;

    private void DetectarEnterBusqueda(KeyboardEventArgs evento)
    {
        if (evento.Key == "Enter") Buscar();
    }

    private void Buscar()
    {
        var texto = textoBusqueda?.Trim() ?? "";

        if (string.IsNullOrWhiteSpace(texto))
        {
            LimpiarBusqueda();
            return;
        }

        var porNombre = todosMunicipios
            .Where(m => m.Nombre.Contains(texto, StringComparison.OrdinalIgnoreCase))
            .ToList();

        var porAtractivo = todosMunicipios
            .Where(m => ObtenerAtractivosPorDefecto(m.Nombre).Any(a => a.Contains(texto, StringComparison.OrdinalIgnoreCase)))
            .ToList();

        var combinados = porNombre.Union(porAtractivo).ToList();

        if (combinados.Count == 0)
        {
            municipiosMostrados = new();
            mensajeBusqueda = $"No encontramos nada para \"{texto}\". Prueba con el nombre de un pueblo o un sitio, como \"Plaza\" o \"Laguna\".";
        }
        else
        {
            municipiosMostrados = combinados;
            mensajeBusqueda = (porAtractivo.Any() && !porNombre.Any())
                ? $"\"{texto}\" está en: {string.Join(", ", porAtractivo.Select(m => m.Nombre))}"
                : null;
        }

        _ = ActualizarMapaConFiltro(municipiosMostrados);
    }

    private void LimpiarBusqueda()
    {
        textoBusqueda = "";
        municipiosMostrados = todosMunicipios;
        mensajeBusqueda = null;
        _ = ActualizarMapaConFiltro(municipiosMostrados);
    }

    private async Task ActualizarMapaConFiltro(List<MunicipioListadoDto> lista)
    {
        var paraMapa = lista
            .Where(m => m.Latitud.HasValue && m.Longitud.HasValue)
            .Select(m => new { id = m.IdMunicipio, nombre = m.Nombre, latitud = m.Latitud!.Value, longitud = m.Longitud!.Value })
            .ToList();

        await JS.InvokeVoidAsync("TurismoConectaMapa.actualizarMarcadores", paraMapa);
    }

    private void AbrirMunicipio(int idMunicipio) => Nav.NavigateTo($"/municipios/{idMunicipio}");

    private void FiltrarPorEtiqueta(int idEtiqueta) => Nav.NavigateTo($"/municipios?idEtiqueta={idEtiqueta}");

    [JSInvokable]
    public void ActualizarZonaMapa(string zona)
    {
        zonaMapa = zona;
        StateHasChanged();
    }

    [JSInvokable]
    public void AbrirMunicipioDesdeMapa(int idMunicipio)
    {
        AbrirMunicipio(idMunicipio);
    }

    private async Task CerrarSesion()
    {
        await JS.InvokeVoidAsync("borrarToken");
        if (AuthStateProvider is JwtAuthStateProvider jwt)
        {
            jwt.NotificarCambioAutenticacion();
        }
        Nav.NavigateTo("/login", forceLoad: true);
    }
}