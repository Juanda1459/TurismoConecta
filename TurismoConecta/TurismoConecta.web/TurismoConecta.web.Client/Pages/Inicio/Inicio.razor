    private List<MaravillaBoyaca> maravillasFiltradas => categoriaSeleccionada == "Todos"
        ? maravillasBoyaca
        : maravillasBoyaca.Where(m => m.Categoria == categoriaSeleccionada).ToList();

    private List<MaravillaBoyaca> maravillasParaMostrar => maravillasFiltradas.Count > 0
        ? maravillasFiltradas.Concat(maravillasFiltradas).ToList()
        : new();

    private void SeleccionarCategoriaMaravilla(string categoria)
    {
        categoriaSeleccionada = categoria;
    }

    private int? totalMunicipios;

    private List<MunicipioListadoDto> todosMunicipios = new();
    private List<MunicipioListadoDto> municipiosMostrados = new();
    private List<EtiquetaDto> etiquetas = new();
    private List<SitioTuristicoDto> sitiosTuristicos = new();
    private string? mensajeBusqueda;

    // Redirige al dashboard según el rol del usuario autenticado
    private async Task IrAlDashboard()
    {
        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        var user = authState.User;

        if (!user.Identity?.IsAuthenticated ?? true)
        {
            Nav.NavigateTo("/login");
            return;
        }

        var rol = user.FindFirst(System.Security.Claims.ClaimTypes.Role)?.Value
               ?? user.FindFirst("role")?.Value;

        var destino = rol switch
        {
            "AdminGeneral"   => "/admin/dashboard",
            "AdminPrincipal" => "/admin/dashboard",
            "AdminMunicipio" => "/municipio/dashboard",
            "AdminComercio"  => "/comercio/dashboard",
            _                => "/perfil"
        };

        Nav.NavigateTo(destino);
    }

    protected override async Task OnInitializedAsync()
    {
        await CargarMunicipios();
        await CargarEtiquetas();
        await CargarSitiosTuristicos();
    }

    private async Task CargarMunicipios()
    {
        cargandoMunicipios = true;
        try
        {
            var resultado = await ApiService.ListarAsync(1, 200);
            todosMunicipios = resultado?.Items?.ToList() ?? new List<MunicipioListadoDto>();
            municipiosMostrados = todosMunicipios;
            totalMunicipios = resultado?.Total;
        }
        catch
        {
            todosMunicipios = new List<MunicipioListadoDto>();
            municipiosMostrados = new List<MunicipioListadoDto>();
            totalMunicipios = 0;
        }
        finally
        {
            cargandoMunicipios = false;
            StateHasChanged();
            _ = InicializarMapaAsync();
        }
    }

    private async Task CargarEtiquetas()
    {
        cargandoEtiquetas = true;
        try
        {
            var resultado = await EtiquetaService.ListarAsync();
            etiquetas = resultado?.ToList() ?? new List<EtiquetaDto>();
        }
        catch
        {
            etiquetas = new List<EtiquetaDto>();
        }
        finally
        {
            cargandoEtiquetas = false;
        }
    }

    private async Task CargarSitiosTuristicos()
    {
        try { sitiosTuristicos = await SitioService.ListarAsync(); }
        catch { sitiosTuristicos = new(); }
    }

    private List<string> ObtenerAtractivosPorDefecto(string nombre)
    {
        if (nombre.Contains("Gámeza", StringComparison.OrdinalIgnoreCase))
            return new List<string> { "Cañón de Gámeza", "Laguna Negra", "Piedra Pintada Muisca", "Parque Minero Tradicional" };
        if (nombre.Contains("Ráquira", StringComparison.OrdinalIgnoreCase))
            return new List<string> { "Plaza de Cerámica", "Monasterio La Candelaria", "Talleres de Alfarería Tradicional" };
        return new List<string> { "Plaza Principal", "Templo Colonial", "Senderos Ecoturísticos", "Mirador del Valle" };
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender && !cargandoMunicipios)
        {
            await InicializarMapaAsync();
        }
    }

    private async Task InicializarMapaAsync()
    {
        if (mapaInicializado) return;

        var municipiosParaMapa = todosMunicipios
            .Where(m => m.Latitud.HasValue && m.Longitud.HasValue)
            .Select(m => new { id = m.IdMunicipio, nombre = m.Nombre, latitud = m.Latitud!.Value, longitud = m.Longitud!.Value })
            .ToList();

        try
        {
            await JS.InvokeVoidAsync("TurismoConectaMapa.inicializar", municipiosParaMapa, DotNetObjectReference.Create(this));
            await JS.InvokeVoidAsync("TurismoConectaMapa.activarScroll");
            mapaInicializado = true;
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error al inicializar mapa: {ex.Message}");
        }
    }

    private void MostrarBuscador() => mostrarBuscador = !mostrarBuscador;

    private void DetectarEnterBusqueda(KeyboardEventArgs evento)
    {
        if (evento.Key == "Enter") Buscar();
    }

    private void Buscar()
    {
        var texto = textoBusqueda?.Trim() ?? "";

        if (string.IsNullOrWhiteSpace(texto))
        {
            LimpiarBusqueda();
            return;
        }

        var porNombre = todosMunicipios
            .Where(m => m.Nombre.Contains(texto, StringComparison.OrdinalIgnoreCase))
            .ToList();

        var porAtractivo = todosMunicipios
            .Where(m => ObtenerAtractivosPorDefecto(m.Nombre).Any(a => a.Contains(texto, StringComparison.OrdinalIgnoreCase)))
            .ToList();

        var combinados = porNombre.Union(porAtractivo).ToList();

        if (combinados.Count == 0)
        {
            municipiosMostrados = new();
            mensajeBusqueda = $"No encontramos nada para \"{texto}\". Prueba con el nombre de un pueblo o un sitio, como \"Plaza\" o \"Laguna\".";
        }
        else
        {
            municipiosMostrados = combinados;
            mensajeBusqueda = (porAtractivo.Any() && !porNombre.Any())
                ? $"\"{texto}\" está en: {string.Join(", ", porAtractivo.Select(m => m.Nombre))}"
                : null;
        }

        _ = ActualizarMapaConFiltro(municipiosMostrados);
    }

    private void LimpiarBusqueda()
    {
        textoBusqueda = "";
        municipiosMostrados = todosMunicipios;
        mensajeBusqueda = null;
        _ = ActualizarMapaConFiltro(municipiosMostrados);
    }

    private async Task ActualizarMapaConFiltro(List<MunicipioListadoDto> lista)
    {
        var paraMapa = lista
            .Where(m => m.Latitud.HasValue && m.Longitud.HasValue)
            .Select(m => new { id = m.IdMunicipio, nombre = m.Nombre, latitud = m.Latitud!.Value, longitud = m.Longitud!.Value })
            .ToList();

        await JS.InvokeVoidAsync("TurismoConectaMapa.actualizarMarcadores", paraMapa);
    }

    private void AbrirMunicipio(int idMunicipio) => Nav.NavigateTo($"/municipios/{idMunicipio}");

    private void FiltrarPorEtiqueta(int idEtiqueta) => Nav.NavigateTo($"/municipios?idEtiqueta={idEtiqueta}");

    [JSInvokable]
    public void ActualizarZonaMapa(string zona)
    {
        zonaMapa = zona;
        StateHasChanged();
    }

    [JSInvokable]
    public void AbrirMunicipioDesdeMapa(int idMunicipio)
    {
        AbrirMunicipio(idMunicipio);
    }

    private async Task CerrarSesion()
    {
        await JS.InvokeVoidAsync("borrarToken");
        if (AuthStateProvider is JwtAuthStateProvider jwt)
        {
            jwt.NotificarCambioAutenticacion();
        }
        Nav.NavigateTo("/login", forceLoad: true);
    }
