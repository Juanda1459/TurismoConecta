@page "/reset-password"
@layout EmptyLayout
@rendermode @(new InteractiveWebAssemblyRenderMode(prerender: false))
@using TurismoConecta.web.Client.Models
@inject HttpClient Http

<div class="page-background">
    <div class="premium-card">
        
        <!-- Mitad Izquierda: Formulario -->
        <div class="form-section">
            <div class="form-wrapper">
                
                <div class="brand">
                    <i class="ph-fill ph-compass"></i>
                    <span>TurismoConecta</span>
                </div>

                <div class="header-text">
                    <h1>Crear nueva contraseña</h1>
                    <p>Por favor, ingresa tu nueva contraseña a continuación.</p>
                </div>

                @if (cambioExitoso)
                {
                    <div class="alert success-alert" style="margin-bottom: 2rem;">
                        <i class="ph-fill ph-check-circle"></i>
                        <span>¡Tu contraseña ha sido actualizada correctamente!</span>
                    </div>
                    
                    <a href="/login" class="submit-btn" style="text-decoration: none;">
                        <span>Ir a Iniciar Sesión</span>
                        <i class="ph-bold ph-arrow-right"></i>
                    </a>
                }
                else if (string.IsNullOrEmpty(modelo.Token))
                {
                    <div class="alert error-alert">
                        <i class="ph-fill ph-warning-circle"></i>
                        <span>Enlace inválido. Falta el token de seguridad. Vuelve a solicitar el cambio de contraseña.</span>
                    </div>
                    <a href="/recuperar-password" class="submit-btn" style="text-decoration: none; margin-top: 1rem;">
                        <span>Volver a solicitar</span>
                    </a>
                }
                else
                {
                    <EditForm Model="@modelo" OnValidSubmit="ActualizarPassword">
                        
                        <!-- Solo como información visual (deshabilitado) -->
                        <div class="input-group">
                            <label>Usuario</label>
                            <div class="input-container">
                                <i class="ph ph-user"></i>
                                <input type="email" class="premium-input" value="@modelo.Email" disabled style="background-color: #e5e7eb; color: #6b7280;" />
                            </div>
                        </div>

                        <div class="input-group">
                            <label>Nueva Contraseña</label>
                            <div class="input-container">
                                <i class="ph ph-lock-key"></i>
                                <InputText type="password" class="premium-input" @bind-Value="modelo.NuevaPassword" placeholder="Escribe tu nueva clave" required />
                            </div>
                        </div>

                        <div class="input-group">
                            <label>Confirmar Contraseña</label>
                            <div class="input-container">
                                <i class="ph ph-lock-key"></i>
                                <InputText type="password" class="premium-input" @bind-Value="modelo.ConfirmPassword" placeholder="Repite la clave" required />
                            </div>
                        </div>

                        <button type="submit" class="submit-btn" disabled="@cargando">
                            @if (cargando)
                            {
                                <div class="spinner"></div>
                                <span>Actualizando...</span>
                            }
                            else
                            {
                                <span>Guardar Contraseña</span>
                                <i class="ph-bold ph-floppy-disk"></i>
                            }
                        </button>
                    </EditForm>
                }

                @if (!string.IsNullOrEmpty(mensajeError))
                {
                    <div class="alert error-alert">
                        <i class="ph-fill ph-warning-circle"></i>
                        <span>@mensajeError</span>
                    </div>
                }

            </div>
        </div>

        <!-- Mitad Derecha: Imagen -->
        <div class="image-section">
            <img src="images/balonRecuperarPas.jpg" alt="Monguí, Boyacá" />
            <div class="image-overlay"></div>
            <div class="image-content">
                <div class="glass-card">
                    <h2>Seguridad Primero</h2>
                    <p>Protege tu cuenta de TurismoConecta creando una contraseña segura que no uses en otros sitios.</p>
                </div>
            </div>
        </div>

    </div>
</div>

@code {
    // Estas dos propiedades capturan automáticamente el 'email' y 'token' de la URL
    [SupplyParameterFromQuery]
    public string? Email { get; set; }

    [SupplyParameterFromQuery]
    public string? Token { get; set; }

    private ResetPasswordRequest modelo = new();
    private string mensajeError = string.Empty;
    private bool cargando = false;
    private bool cambioExitoso = false;

    protected override void OnInitialized()
    {
        // Al cargar la página, inyectamos los datos de la URL en nuestro modelo
        modelo.Email = Email ?? string.Empty;
        modelo.Token = Token ?? string.Empty;
    }

    private async Task ActualizarPassword()
    {
        mensajeError = string.Empty;
        cargando = true;

        // 1. Validación en frontend: confirmar contraseñas
        if (modelo.NuevaPassword != modelo.ConfirmPassword)
        {
            mensajeError = "Las contraseñas no coinciden. Por favor, verifica.";
            cargando = false;
            return;
        }

        if (modelo.NuevaPassword.Length < 6)
        {
            mensajeError = "La contraseña debe tener al menos 6 caracteres.";
            cargando = false;
            return;
        }

        try
        {
            // 2. Enviamos al endpoint de tu backend (ResetPasswordRequestDto)
            var resultadoHttp = await Http.PostAsJsonAsync("api/auth/reset-password", modelo);

            if (resultadoHttp.IsSuccessStatusCode)
            {
                cambioExitoso = true;
            }
            else
            {
                // Si el backend lanza el InvalidOperationException ("Token inválido", etc.)
                var contenido = await resultadoHttp.Content.ReadAsStringAsync();
                mensajeError = string.IsNullOrWhiteSpace(contenido) 
                    ? "El enlace es inválido o ha expirado." 
                    : contenido;
            }
        }
        catch (Exception)
        {
            mensajeError = "No se pudo conectar con el servidor.";
        }
        finally
        {
            cargando = false;
        }
    }
}