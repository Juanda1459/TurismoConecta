@page "/itinerarios/{Id:int}"
@rendermode @(new InteractiveWebAssemblyRenderMode(prerender: false))
@using TurismoConecta.web.Client.Services
@inject ItinerarioApiService ApiService
@inject NavigationManager Nav
@inject IJSRuntime JS

@if (cargando)
{
    <p>Cargando detalles...</p>
}
else if (itinerario == null)
{
    <div class="alert alert-danger">
        <p>No se pudo cargar el itinerario.</p>
        <button class="btn btn-primary" @onclick='() => Nav.NavigateTo("/itinerarios")'>Volver</button>
    </div>
}
else
{
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h3>@itinerario.Nombre</h3>
        <button class="btn btn-outline-secondary" @onclick='() => Nav.NavigateTo("/itinerarios")'>Volver</button>
    </div>

    <div class="info-box">
        <p>
            <strong>Fechas:</strong> 
            @(itinerario.FechaInicio?.ToString("dd/MM/yyyy") ?? "No definida") al 
            @(itinerario.FechaFin?.ToString("dd/MM/yyyy") ?? "No definida")
        </p>
        @if (!string.IsNullOrEmpty(itinerario.Observaciones))
        {
            <p><strong>Observaciones:</strong> @itinerario.Observaciones</p>
        }

        <hr />
        
        <div class="mt-3">
            @if (itinerario.Compartido)
            {
                <div class="alert alert-success">
                    <strong>Público:</strong><br/>
                    <a href="/itinerarios/compartido/@itinerario.CodigoCompartir" target="_blank" class="alert-link">
                        Ver vista pública
                    </a>
                </div>
                <button class="btn btn-warning" @onclick="ToggleCompartir" disabled="@cambiandoCompartir">
                    @(cambiandoCompartir ? "Procesando..." : "Dejar de compartir")
                </button>
            }
            else
            {
                <div class="alert alert-secondary">
                    <strong>Privado:</strong> Solo tú puedes verlo.
                </div>
                <button class="btn btn-success" @onclick="ToggleCompartir" disabled="@cambiandoCompartir">
                    @(cambiandoCompartir ? "Procesando..." : "Compartir Itinerario")
                </button>
            }
        </div>
    </div>

    <h4 class="mb-3">Ruta de Viaje</h4>
    
    @if (!itinerario.Paradas.Any())
    {
        <p>No hay paradas registradas.</p>
    }
    else
    {
        var paradasAgrupadasPorDia = itinerario.Paradas.GroupBy(p => p.DiaNumero).OrderBy(g => g.Key);

        <div class="row">
            @foreach (var grupoDia in paradasAgrupadasPorDia)
            {
                <div class="col-md-6 mb-4">
                    <div class="card shadow-sm h-100">
                        <div class="card-header bg-primary text-white">
                            <h5 class="mb-0">Día @grupoDia.Key</h5>
                        </div>
                        <ul class="list-group list-group-flush">
                            @foreach (var parada in grupoDia.OrderBy(p => p.Orden))
                            {
                                <li class="list-group-item parada-item">
                                    <span class="numero-parada">@parada.Orden</span>
                                    <span>@parada.NombreMunicipio</span>
                                </li>
                            }
                        </ul>
                    </div>
                </div>
            }
        </div>
    }
}

@code {
    [Parameter] public int Id { get; set; }
    private ItinerarioDetalleDto? itinerario;
    private bool cargando = true;
    private bool cambiandoCompartir = false;

    protected override async Task OnInitializedAsync()
    {
        cargando = true;
        itinerario = await ApiService.ObtenerDetalleAsync(Id);
        cargando = false;
    }

    private async Task ToggleCompartir()
    {
        if (itinerario == null) return;
        cambiandoCompartir = true;
        
        var resultado = await ApiService.ToggleCompartirAsync(Id);
        if (resultado != null)
        {
            itinerario.Compartido = resultado.Compartido;
            itinerario.CodigoCompartir = resultado.CodigoCompartir;
        }
        else await JS.InvokeVoidAsync("alert", "Error al cambiar el estado.");

        cambiandoCompartir = false;
    }
}