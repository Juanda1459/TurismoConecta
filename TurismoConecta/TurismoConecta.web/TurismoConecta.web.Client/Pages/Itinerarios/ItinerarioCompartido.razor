@page "/itinerarios/compartido/{Codigo:guid}"
@layout EmptyLayout
@rendermode @(new InteractiveWebAssemblyRenderMode(prerender: false))
@using TurismoConecta.web.Client.Services
@inject ItinerarioApiService ApiService
@inject NavigationManager Nav

<HeadContent>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin="anonymous" />
    <link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,500;0,600;0,700;1,400&family=Montserrat:wght@300;400;500;600;700&display=swap" rel="stylesheet" />
</HeadContent>

<div class="compartido-page">

    @* CARGANDO *@
    @if (cargando)
    {
        <div class="pantalla-espera-inmersiva">
            <img src="https://images.unsplash.com/photo-1518105779142-d975f22f1b0a?q=80&w=1600&auto=format&fit=crop"
                 alt="Boyacá" class="espera-bg-img" />
            <div class="espera-scrim">
                <div class="espera-contenido">
                    <span class="espera-eyebrow">Itinerario Compartido</span>
                    <h2 class="espera-lugar">Descubriendo Boyacá...</h2>
                    <p class="espera-cita">"Viajar es la única cosa que compras que te hace más rico."</p>
                    <div class="espera-indicador">
                        <div class="spinner-anillo-selva"></div>
                        <span class="espera-texto-progreso">Cargando el itinerario compartido...</span>
                    </div>
                </div>
            </div>
        </div>
    }

    @* ENLACE NO VÁLIDO *@
    else if (itinerario == null)
    {
        <div class="compartido-container">
            <div class="compartido-error">
                <span>🗺️</span>
                <h2>Enlace no válido o expirado</h2>
                <p>El itinerario no existe o el creador dejó de compartirlo.</p>
                <button class="btn-ir-inicio" @onclick='() => Nav.NavigateTo("/")'>
                    Explorar TurismoConecta →
                </button>
            </div>
        </div>
    }

    @* ITINERARIO PÚBLICO *@
    else
    {
        @* HERO *@
        <div class="compartido-hero">
            <div class="compartido-hero-contenido">
                <span class="compartido-eyebrow">✦ Ruta Boyacense Compartida</span>
                <h1 class="compartido-nombre">@itinerario.Nombre</h1>

                <div class="compartido-hero-meta">
                    @if (itinerario.FechaInicio.HasValue)
                    {
                        <span class="hero-dato">
                            📅 @itinerario.FechaInicio.Value.ToString("dd 'de' MMMM")
                            @if (itinerario.FechaFin.HasValue)
                            {
                                <text> → @itinerario.FechaFin.Value.ToString("dd 'de' MMMM, yyyy")</text>
                            }
                        </span>
                    }
                    <span class="hero-dato">📍 @itinerario.Paradas.Count municipio@(itinerario.Paradas.Count != 1 ? "s" : "")</span>
                </div>
            </div>
        </div>

        @* BANNER CTA *@
        <div class="banner-cta">
            <p>🌟 Estás viendo un itinerario compartido.</p>
            <a href="/register" class="btn-cta-registro">Crea tu cuenta gratis y planea el tuyo →</a>
        </div>

        <div class="compartido-container">

            @* OBSERVACIONES *@
            @if (!string.IsNullOrWhiteSpace(itinerario.Observaciones))
            {
                <div class="compartido-seccion">
                    <span class="compartido-seccion-label">Notas del Viajero</span>
                    <blockquote class="compartido-cita">
                        "@itinerario.Observaciones"
                    </blockquote>
                </div>
            }

            @* PARADAS *@
            <div class="compartido-seccion">
                <span class="compartido-seccion-label">Ruta Sugerida</span>

                @if (!itinerario.Paradas.Any())
                {
                    <p style="color: #5A6961; font-size: 0.90rem;">Aún no hay paradas en este itinerario.</p>
                }
                else
                {
                    var porDia = itinerario.Paradas.GroupBy(p => p.DiaNumero).OrderBy(g => g.Key);

                    <div class="compartido-dias-grid">
                        @foreach (var dia in porDia)
                        {
                            <div class="compartido-dia-card">
                                <div class="dia-card-header">
                                    <span class="dia-card-label">Día @dia.Key</span>
                                    <span class="dia-card-count">@dia.Count() parada@(dia.Count() != 1 ? "s" : "")</span>
                                </div>
                                <ul class="dia-card-lista">
                                    @foreach (var parada in dia.OrderBy(p => p.Orden))
                                    {
                                        <li class="dia-card-item">
                                            <span class="item-num">@parada.Orden</span>
                                            <a href="/municipios/@parada.IdMunicipio" class="item-nombre">
                                                @parada.NombreMunicipio
                                            </a>
                                        </li>
                                    }
                                </ul>
                            </div>
                        }
                    </div>
                }
            </div>

            @* FOOTER CTA *@
            <div class="compartido-footer-cta">
                <h3>¿Te inspiró esta ruta?</h3>
                <p>Arma tu propio itinerario por Boyacá con TurismoConecta.</p>
                <a href="/register" class="btn-footer-cta">Comenzar gratis →</a>
            </div>
        </div>
    }
</div>

@code {
    [Parameter] public Guid Codigo { get; set; }
    private ItinerarioDetalleDto? itinerario;
    private bool cargando = true;

    protected override async Task OnInitializedAsync()
    {
        cargando = true;
        itinerario = await ApiService.ObtenerCompartidoAsync(Codigo);
        cargando = false;
    }
}