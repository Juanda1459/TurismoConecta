@page "/itinerarios"
@layout EmptyLayout
@rendermode @(new InteractiveWebAssemblyRenderMode(prerender: false))
@using TurismoConecta.web.Client.Services
@inject ItinerarioApiService ApiService
@inject NavigationManager Nav
@inject IJSRuntime JS
@inject AuthenticationStateProvider AuthStateProvider

<HeadContent>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin="anonymous" />
    <link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,500;0,600;0,700;1,400&family=Montserrat:wght@300;400;500;600;700&display=swap" rel="stylesheet" />
</HeadContent>

<div class="lista-page">
    <header class="selva-form-nav">
        <button class="nav-back-link" @onclick="Volver">
            <span class="nav-back-arrow">←</span> Volver al Panel
        </button>
        <a href="/" class="logo-marco-dorado" title="TurismoConecta">
            <img src="images/turismo-conecta-logo.png" alt="TurismoConecta" class="topbar-logo-img" />
        </a>
    </header>

    @* PANTALLA DE ESPERA *@
    @if (cargando)
    {
        <div class="pantalla-espera-inmersiva">
            <img src="https://images.unsplash.com/photo-1506744038136-46273834b3fb?q=80&w=1600&auto=format&fit=crop"
                 alt="Boyacá" class="espera-bg-img" />
            <div class="espera-scrim">
                <div class="espera-contenido">
                    <span class="espera-eyebrow">Mis Itinerarios</span>
                    <h2 class="espera-lugar">Tus Rutas Boyacenses</h2>
                    <p class="espera-cita">"Cada viaje es una historia que merece ser recordada."</p>
                    <div class="espera-indicador">
                        <div class="spinner-anillo-selva"></div>
                        <span class="espera-texto-progreso">Cargando tus itinerarios...</span>
                    </div>
                </div>
            </div>
        </div>
    }

    @* ESTADO: NO AUTENTICADO *@
    else if (noAutenticado)
    {
        <div class="lista-container">
            <div class="estado-vacio">
                <div class="estado-icono-wrap">
                    <svg width="34" height="34" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                        <rect x="3" y="11" width="18" height="11" rx="2" ry="2"/>
                        <path d="M7 11V7a5 5 0 0 1 10 0v4"/>
                    </svg>
                </div>
                <h3>Inicia sesión para ver tus itinerarios</h3>
                <p>Guarda y organiza tus rutas personalizadas por Boyacá en tu cuenta.</p>
                <button class="btn-accion-primaria" @onclick='() => Nav.NavigateTo("/login")'>
                    Iniciar Sesión →
                </button>
            </div>
        </div>
    }

    @* ESTADO: ERROR *@
    else if (huboError)
    {
        <div class="lista-container">
            <div class="estado-vacio">
                <div class="estado-icono-wrap">
                    <svg width="34" height="34" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                        <circle cx="12" cy="12" r="10"/>
                        <line x1="12" y1="8" x2="12" y2="12"/>
                        <line x1="12" y1="16" x2="12.01" y2="16"/>
                    </svg>
                </div>
                <h3>No pudimos cargar tus itinerarios</h3>
                <p>Revisa tu conexión e intenta nuevamente.</p>
                <button class="btn-accion-primaria" @onclick="CargarItinerarios">Reintentar</button>
            </div>
        </div>
    }

    @* ESTADO: VACÍO *@
    else if (itinerarios != null && !itinerarios.Any())
    {
        <div class="lista-container">
            <header class="lista-header">
                <span class="lista-eyebrow">Planificador de Viajes</span>
                <h1 class="lista-titulo">Mis Itinerarios</h1>
            </header>
            <div class="estado-vacio">
                <div class="estado-icono-wrap">
                    <svg width="34" height="34" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                        <polygon points="1 6 1 22 8 18 16 22 23 18 23 2 16 6 8 2 1 6"/>
                        <line x1="8" y1="2" x2="8" y2="18"/>
                        <line x1="16" y1="6" x2="16" y2="22"/>
                    </svg>
                </div>
                <h3>Aún no tienes itinerarios</h3>
                <p>Explora los municipios de Boyacá y arma tu primera ruta.</p>
                <button class="btn-accion-primaria" @onclick='() => Nav.NavigateTo("/municipios")'>
                    Explorar Municipios →
                </button>
            </div>
        </div>
    }

    @* LISTA DE ITINERARIOS *@
    else if (itinerarios != null)
    {
        <div class="lista-container">
            <header class="lista-header">
                <div class="lista-header-texto">
                    <span class="lista-eyebrow">Planificador de Viajes</span>
                    <h1 class="lista-titulo">Mis Itinerarios</h1>
                    <p class="lista-subtitulo">
                        @itinerarios.Count ruta@(itinerarios.Count != 1 ? "s" : "") planificada@(itinerarios.Count != 1 ? "s" : "") por Boyacá
                    </p>
                </div>
                <button class="btn-nuevo-itinerario" @onclick='() => Nav.NavigateTo("/municipios")'>
                    ＋ Nueva Ruta
                </button>
            </header>

            <div class="grid-itinerarios">
                @foreach (var iti in itinerarios)
                {
                    <div class="card-itinerario-lista" @onclick="() => VerDetalle(iti.IdItinerario)">
                        <div class="card-iti-top">
                            <div class="card-iti-icono">
                                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                                    <circle cx="12" cy="12" r="10"/>
                                    <polygon points="16.24 7.76 14.12 14.12 7.76 16.24 9.88 9.88 16.24 7.76"/>
                                </svg>
                            </div>
                            <span class="badge-ruta-tag">Ruta</span>
                        </div>

                        <div class="card-iti-body">
                            <h3 class="card-iti-nombre">@iti.Nombre</h3>

                            <div class="card-iti-meta">
                                @if (iti.FechaInicio.HasValue)
                                {
                                    <span class="meta-item">
                                        <svg class="meta-svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round">
                                            <rect x="3" y="4" width="18" height="18" rx="2" ry="2"/>
                                            <line x1="16" y1="2" x2="16" y2="6"/>
                                            <line x1="8" y1="2" x2="8" y2="6"/>
                                            <line x1="3" y1="10" x2="21" y2="10"/>
                                        </svg>
                                        <span>@iti.FechaInicio.Value.ToString("dd MMM yyyy")</span>
                                        @if (iti.FechaFin.HasValue)
                                        {
                                            <span>→ @iti.FechaFin.Value.ToString("dd MMM yyyy")</span>
                                        }
                                    </span>
                                }
                                <span class="meta-item">
                                    <svg class="meta-svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round">
                                        <path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"/>
                                        <circle cx="12" cy="10" r="3"/>
                                    </svg>
                                    <span>@iti.CantidadParadas municipio@(iti.CantidadParadas != 1 ? "s" : "")</span>
                                </span>
                            </div>
                        </div>

                        <div class="card-iti-footer" @onclick:stopPropagation="true">
                            <button class="btn-iti-ver" @onclick="() => VerDetalle(iti.IdItinerario)">
                                <span>Ver detalle</span>
                                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                    <line x1="5" y1="12" x2="19" y2="12"/>
                                    <polyline points="12 5 19 12 12 19"/>
                                </svg>
                            </button>
                            <button class="btn-iti-eliminar" @onclick="() => Eliminar(iti.IdItinerario)"
                                    title="Eliminar itinerario">
                                <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                                    <polyline points="3 6 5 6 21 6"/>
                                    <path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"/>
                                    <line x1="10" y1="11" x2="10" y2="17"/>
                                    <line x1="14" y1="11" x2="14" y2="17"/>
                                </svg>
                            </button>
                        </div>
                    </div>
                }
            </div>
        </div>
    }
</div>

@code {
    private List<ItinerarioListadoDto>? itinerarios;
    private bool cargando = true;
    private bool huboError = false;
    private bool noAutenticado = false;

    protected override async Task OnInitializedAsync() => await CargarItinerarios();

    private async Task CargarItinerarios()
    {
        cargando = true;
        huboError = false;
        noAutenticado = false;

        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        if (!(authState.User.Identity?.IsAuthenticated ?? false))
        {
            noAutenticado = true;
            cargando = false;
            return;
        }

        var resultado = await ApiService.ListarAsync();
        if (resultado == null) huboError = true;
        else itinerarios = resultado;
        cargando = false;
    }

    private void VerDetalle(int id) => Nav.NavigateTo($"/itinerarios/{id}");

    private async Task Eliminar(int id)
    {
        bool confirmado = await JS.InvokeAsync<bool>("confirm", "¿Eliminar este itinerario? Esta acción no se puede deshacer.");
        if (confirmado)
        {
            var exito = await ApiService.EliminarAsync(id);
            if (exito) await CargarItinerarios();
            else await JS.InvokeVoidAsync("alert", "No se pudo eliminar el itinerario.");
        }
    }

    private async Task Volver()
    {
        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        if (authState.User.IsInRole("AdminGeneral"))
            Nav.NavigateTo("/admin/dashboard");
        else if (authState.User.IsInRole("AdminMunicipio"))
            Nav.NavigateTo("/municipio/dashboard");
        else if (authState.User.IsInRole("AdminComercio"))
            Nav.NavigateTo("/comercio/dashboard");
        else
            Nav.NavigateTo("/");
    }
}