@page "/municipios/crear"
@using TurismoConecta.web.Client.Services
@using Microsoft.AspNetCore.Authorization
@attribute [Authorize(Roles = "AdminGeneral")]
@inject MunicipioApiService ApiService
@inject NavigationManager Nav

<h3>Crear nuevo municipio</h3>

<EditForm Model="dto" OnValidSubmit="Guardar">
    <DataAnnotationsValidator />
    <ValidationSummary />

    <label>Nombre</label>
    <InputText @bind-Value="dto.Nombre" />

    <label>Descripción</label>
    <InputTextArea @bind-Value="dto.Descripcion" />

    <button type="submit">Crear municipio</button>
</EditForm>

@if (mensajeError is not null)
{
    <p class="mensaje-error">@mensajeError</p>
}

@code {
    private MunicipioCrearDto dto = new() { IdDepartamento = 1 }; // 1 = Boyacá
    private string? mensajeError;

    private async Task Guardar()
    {
        var (exito, idCreado, error) = await ApiService.CrearAsync(dto);
        if (exito) Nav.NavigateTo($"/municipios/{idCreado}/editar");
        else mensajeError = error ?? "No se pudo crear el municipio.";
    }
}