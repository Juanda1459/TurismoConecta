    private string ObtenerImagenMunicipio(string nombre, string? imagenUrl)
    {
        if (!string.IsNullOrWhiteSpace(imagenUrl) && imagenUrl.StartsWith("http")) return imagenUrl;
        if (string.IsNullOrWhiteSpace(nombre)) return "https://images.unsplash.com/photo-1518105779142-d975f22f1b0a?q=80&w=1400&auto=format&fit=crop";

        string nombreLimpio = nombre.Replace(" de ", "").Replace("á", "a").Replace("Á", "A").Replace("é", "e").Replace("É", "E").Replace("í", "i").Replace("Í", "I").Replace("ó", "o").Replace("Ó", "O").Replace("ú", "u").Replace("Ú", "U").Replace(" ", "");
        return $"https://localhost:7078/images/municipios/{nombreLimpio}ImgPerfil.jpg";
    }

    private string FormatearClimaDiscreto(string clima)
    {
        if (string.IsNullOrWhiteSpace(clima)) return "Clima templado";
        var match = System.Text.RegularExpressions.Regex.Match(clima, @"\d+(\s*°\s*C|\s*°C|\s*°)");
        if (match.Success)
        {
            string g = match.Value.Replace(" ", "");
            if (!g.Contains("°C")) g += "C";
            return g;
        }
        return clima.Length > 20 ? clima[..18] + "..." : clima;
    }

    private List<string> ObtenerAtractivosPorDefecto(string nombre)
    {
        if (nombre.Contains("Gámeza", StringComparison.OrdinalIgnoreCase))
        {
            return new List<string> { "Cañón de Gámeza", "Laguna Negra", "Piedra Pintada Muisca", "Parque Minero Tradicional" };
        }
        if (nombre.Contains("Ráquira", StringComparison.OrdinalIgnoreCase))
        {
            return new List<string> { "Plaza de Cerámica", "Monasterio La Candelaria", "Talleres de Alfarería Tradicional" };
        }
        return new List<string> { "Plaza Principal", "Templo Colonial", "Senderos Ecoturísticos", "Mirador del Valle" };
    }

    private string ObtenerClaseBadge(string tipo)
    {
        return tipo.ToLowerInvariant() switch
        {
            "patronal" => "patronal",
            "cultural" => "cultural",
            "gastronómica" or "gastronomica" => "gastronomica",
            "artesanal" => "artesanal",
            "deportiva" => "deportiva",
            "religiosa" => "religiosa",
            _ => "general"
        };
    }

    private string ObtenerUrlGoogleMaps(string nombre, decimal? lat, decimal? lon)
    {
        if (lat.HasValue && lon.HasValue && lat != 0 && lon != 0)
        {
            return $"https://www.google.com/maps/search/?api=1&query={lat.Value.ToString(System.Globalization.CultureInfo.InvariantCulture)},{lon.Value.ToString(System.Globalization.CultureInfo.InvariantCulture)}";
        }
        return $"https://www.google.com/maps/search/?api=1&query={Uri.EscapeDataString(nombre + ", Boyacá, Colombia")}";
    }

    private string ObtenerUrlIframeMaps(string nombre, decimal? lat, decimal? lon)
    {
        if (lat.HasValue && lon.HasValue && lat != 0 && lon != 0)
        {
            return $"https://maps.google.com/maps?q={lat.Value.ToString(System.Globalization.CultureInfo.InvariantCulture)},{lon.Value.ToString(System.Globalization.CultureInfo.InvariantCulture)}&hl=es&z=14&output=embed";
        }
        return $"https://maps.google.com/maps?q={Uri.EscapeDataString(nombre + ", Boyacá, Colombia")}&hl=es&z=13&output=embed";
    }
