.grid-municipios {
display: grid;
grid-template-columns: repeat(auto-fill, minmax(240px, 1fr));
gap: 16px;
margin-top: 16px;
}

.card-municipio {
border: 1px solid #ddd;
border-radius: 8px;
padding: 12px;
}

.card-municipio img {
width: 100%;
height: 140px;
object-fit: cover;
border-radius: 6px;
}

.paginacion {
display: flex;
align-items: center;
gap: 12px;
margin-top: 16px;
}

.mensaje-error {
color: #b00020;
}