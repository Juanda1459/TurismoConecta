@page "/login"
@rendermode @(new InteractiveWebAssemblyRenderMode(prerender: false))
@using TurismoConecta.web.Client.Models
@inject HttpClient Http

<div class="split-container">
    <div class="form-side">
        <div class="brand">
            <span class="brand-icon">🧭</span>
            <span class="brand-name">TurismoConecta</span>
        </div>

        <h2>¡Bienvenido de Nuevo!</h2>
        <p class="subtitle">Por favor, ingresa tus datos de acceso</p>

        <EditForm Model="@modelo" OnValidSubmit="HacerLogin">
            <div class="form-group">
                <label>Correo Electrónico</label>
                <InputText class="form-control" @bind-Value="modelo.Email" placeholder="Ingresa tu correo" />
            </div>
            <div class="form-group">
                <label>Contraseña</label>
                <InputText type="password" class="form-control" @bind-Value="modelo.Password" placeholder="Ingresa tu contraseña" />
            </div>

            <div class="forgot-link">
                <a href="/recuperar-password">¿Olvidaste tu contraseña?</a>
            </div>

            <button type="submit" class="btn-primary" disabled="@cargando">
                @if (cargando)
                {
                    <span class="spinner-border spinner-border-sm me-2"></span>
                }
                Iniciar Sesión
            </button>
        </EditForm>

        @if (!string.IsNullOrEmpty(mensajeError))
        {
            <div class="alert-error">@mensajeError</div>
        }

        @if (respuesta is not null)
        {
            <div class="alert-success">
                ¡Bienvenido, @respuesta.NombreCompleto! (Rol: @respuesta.Rol)
            </div>
        }

        <p class="signup-link">¿No tienes cuenta? <a href="/register">Regístrate</a></p>
    </div>

    <div class="image-side">
        <img src="images/LagunaNegraLogin.jpg" alt="Boyacá" />
        <div class="image-caption">
            Descubre los tesoros escondidos de Boyacá, tu próximo viaje comienza aquí...
        </div>
    </div>
</div>

@code {
    private LoginRequest modelo = new();
    private AuthResponse? respuesta;
    private string mensajeError = string.Empty;
    private bool cargando = false;

    private async Task HacerLogin()
    {
        mensajeError = string.Empty;
        respuesta = null;
        cargando = true;

        try
        {
            var resultadoHttp = await Http.PostAsJsonAsync("api/auth/login", modelo);

            if (resultadoHttp.IsSuccessStatusCode)
            {
                respuesta = await resultadoHttp.Content.ReadFromJsonAsync<AuthResponse>();
            }
            else
            {
                mensajeError = "Correo o contraseña incorrectos.";
            }
        }
        catch (Exception)
        {
            mensajeError = "No se pudo conectar con el servidor.";
        }
        finally
        {
            cargando = false;
        }
    }
}