@page "/recuperar-password"
@layout EmptyLayout
@rendermode @(new InteractiveWebAssemblyRenderMode(prerender: false))
@using TurismoConecta.web.Client.Models
@inject HttpClient Http

<div class="page-background">
    <div class="premium-card">

        <!-- Mitad Izquierda: Formulario -->
        <div class="form-section">
            <div class="form-wrapper">

                <div class="brand">
                    <i class="ph-fill ph-compass"></i>
                    <span>TurismoConecta</span>
                </div>

                <div class="header-text">
                    <h1>Recuperar Contraseña</h1>
                    <p>Ingresa tu correo electrónico y te enviaremos las instrucciones para restablecer tu contraseña.</p>
                </div>

                @if (envioExitoso)
                {
                    <div class="alert success-alert" style="margin-bottom: 2rem;">
                        <i class="ph-fill ph-check-circle"></i>
                        <span>Si el correo existe en nuestro sistema, recibirás un enlace de recuperación en los próximos minutos.</span>
                    </div>

                    <a href="/login" class="submit-btn" style="text-decoration: none;">
                        <span>Volver al inicio de sesión</span>
                    </a>
                }
                else
                {
                    <EditForm Model="@modelo" OnValidSubmit="EnviarCorreoRecuperacion">
                        <div class="input-group">
                            <label>Correo Electrónico</label>
                            <div class="input-container">
                                <i class="ph ph-envelope-simple"></i>
                                <InputText type="email" class="premium-input" @bind-Value="modelo.Email" placeholder="ejemplo@correo.com" required />
                            </div>
                        </div>

                        <button type="submit" class="submit-btn" disabled="@cargando">
                            @if (cargando)
                            {
                                <div class="spinner"></div>
                                <span>Enviando...</span>
                            }
                            else
                            {
                                <span>Enviar enlace de recuperación</span>
                                <i class="ph-bold ph-paper-plane-tilt"></i>
                            }
                        </button>
                    </EditForm>
                }

                @if (!string.IsNullOrEmpty(mensajeError))
                {
                    <div class="alert error-alert">
                        <i class="ph-fill ph-warning-circle"></i>
                        <span>@mensajeError</span>
                    </div>
                }

                @if (!envioExitoso)
                {
                    <div class="register-link">
                        ¿Recordaste tu contraseña? <a href="/login">Inicia sesión aquí</a>
                    </div>
                }
            </div>
        </div>

        <!-- Mitad Derecha: Imagen inmersiva -->
        <div class="image-section">
            <img src="images/LagunaNegraLogin.jpg" alt="Laguna Negra, Boyacá" />
            <div class="image-overlay"></div>
            <div class="image-content">
                <div class="glass-card">
                    <h2>Tranquilo, te ayudaremos</h2>
                    <p>Sabemos que olvidar la contraseña es frustrante. Te ayudaremos a recuperar el acceso para que sigas planeando tu próxima aventura.</p>
                </div>
            </div>
        </div>

    </div>
</div>

@code {
    private ForgotPasswordRequest modelo = new();
    private string mensajeError = string.Empty;
    private bool cargando = false;
    private bool envioExitoso = false;

    private async Task EnviarCorreoRecuperacion()
    {
        mensajeError = string.Empty;
        cargando = true;

        try
        {
            // Apunta al endpoint de tu backend que me mostraste
            var resultadoHttp = await Http.PostAsJsonAsync("api/auth/forgot-password", modelo);

            if (resultadoHttp.IsSuccessStatusCode)
            {
                // Mostramos el mensaje de éxito y ocultamos el formulario
                envioExitoso = true;
            }
            else
            {
                mensajeError = "Ocurrió un problema al procesar la solicitud.";
            }
        }
        catch (Exception)
        {
            mensajeError = "No se pudo conectar con el servidor. Revisa tu conexión.";
        }
        finally
        {
            cargando = false;
        }
    }
}